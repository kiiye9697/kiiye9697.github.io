---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { profile, writingLinks } from "../lib/resume";
import { getWritingSlug } from "../lib/slugs";

const notes = (await getCollection("writing")).sort(
  (a, b) => a.data.order - b.data.order
);

const notesWithCover = notes.map((note) => {
  const imgMatch = note.body.match(/!\[.*?\]\((https:\/\/[^)]+)\)/);
  return { note, cover: imgMatch ? imgMatch[1] : null };
});

const courseGroups = notesWithCover.reduce<Record<string, typeof notesWithCover>>((acc, item) => {
  const key = item.note.data.course;
  acc[key] ??= [];
  acc[key].push(item);
  return acc;
}, {});
---

<BaseLayout title={`技术帖 | ${profile.name}`} description="个人博客 — 课程笔记与图形学技术整理。">
  <div class="page-shell">
    <SectionHeader
      eyebrow="Writing"
      title="技术帖"
      description=""
    />

    <section class="page-section">
      <div class="writing-overview">
        {writingLinks.map((item) => (
          <a class="panel writing-link-card" href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noreferrer" : undefined}>
            <span class="card-label">{item.meta}</span>
            <h3>{item.title}</h3>
            <p>{item.excerpt}</p>
          </a>
        ))}
      </div>
    </section>

    {Object.entries(courseGroups).map(([course, items]) => (
      <section class="page-section writing-course-section">
        <SectionHeader
          eyebrow="Course Notes"
          title={course}
          description={`${items.length} 篇`}
        />
        <div class="article-grid">
          {items.map(({ note, cover }) => (
            <a class="article-card reveal" href={`/writing/${getWritingSlug(note.id)}/`}>
              {cover && <img src={cover} alt="" loading="lazy" />}
              <span class="card-label">{note.data.course}</span>
              <h3>{note.data.title}</h3>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
