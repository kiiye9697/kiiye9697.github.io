---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { profile, writingLinks } from "../lib/resume";
import { getWritingSlug } from "../lib/slugs";

const notes = (await getCollection("writing")).sort(
  (a, b) => a.data.order - b.data.order
);

const courseGroups = notes.reduce<Record<string, typeof notes>>((acc, note) => {
  const key = note.data.course;
  acc[key] ??= [];
  acc[key].push(note);
  return acc;
}, {});
---

<BaseLayout title={`技术帖 | ${profile.name}`} description="Rendering、PCG、TA 技术帖索引">
  <div class="page-shell">
    <SectionHeader
      eyebrow="Writing"
      title="技术帖"
      description="GAMES101 / GAMES202 / GAMES104 等 Markdown 笔记已导入，支持 LaTeX 公式、代码块和远程图片。"
    />

    <section class="writing-stage reveal">
      <span>WRITING / RENDERING / PCG / TA</span>
      <h1>把技术理解沉淀成可追溯的笔记</h1>
      <p>站内技术帖由 Astro 内容集合驱动，课程笔记、公式与代码块保持独立归档。</p>
    </section>

    <section class="page-section">
      <div class="writing-overview">
        <article class="panel">
          <span class="card-label">Imported Notes</span>
          <h3>{notes.length} 篇 Markdown</h3>
          <p>已跳过空文件，保留原始课程来源与文章标题。</p>
        </article>
        {writingLinks.map((item) => (
          <a class="panel writing-link-card" href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noreferrer" : undefined}>
            <span class="card-label">{item.meta}</span>
            <h3>{item.title}</h3>
            <p>{item.excerpt}</p>
          </a>
        ))}
      </div>
    </section>

    {Object.entries(courseGroups).map(([course, items]) => (
      <section class="page-section writing-course-section">
        <SectionHeader
          eyebrow="Course Notes"
          title={course}
          description={`${items.length} 篇笔记`}
        />
        <div class="article-grid">
          {items.map((note) => (
            <a class="article-card reveal" href={`/writing/${getWritingSlug(note.id)}/`}>
              <span class="card-label">{note.data.course}</span>
              <h3>{note.data.title}</h3>
              <p>LaTeX / Markdown / 代码块 / 图片引用已接入 Astro 渲染链路。</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
