---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { profile } from "../lib/resume";
import { getWritingSlug } from "../lib/slugs";

const notes = (await getCollection("writing")).sort(
  (a, b) => a.data.order - b.data.order
);

const notesWithCover = notes.map((note) => {
  const imgMatch = note.body.match(/!\[.*?\]\((https:\/\/[^)]+)\)/);
  return { note, cover: imgMatch ? imgMatch[1] : null };
});

const courseGroups = notesWithCover.reduce<Record<string, typeof notesWithCover>>((acc, item) => {
  const key = item.note.data.course;
  acc[key] ??= [];
  acc[key].push(item);
  return acc;
}, {});
---

<BaseLayout title={`技术帖 | ${profile.name}`} description="个人博客 — 课程笔记与图形学技术整理。">
  <div class="page-shell">
    <SectionHeader
      eyebrow="Writing"
      title="技术帖"
      description=""
    />

    <div class="writing-filters">
      <input type="search" aria-label="搜索笔记" placeholder="搜索笔记" data-note-search />
      <select aria-label="笔记分类" data-note-category><option value="">全部分类</option>{Object.keys(courseGroups).map(course => <option>{course}</option>)}</select>
      <a href="/editor/">写笔记</a>
    </div>
    <p data-no-results hidden>没有匹配的笔记。</p>

    {Object.entries(courseGroups).map(([course, items]) => (
      <section class="page-section writing-course-section" data-note-group={course}>
        <SectionHeader
          eyebrow="Course Notes"
          title={course}
          description={`${items.length} 篇`}
        />
        <div class="article-grid">
          {items.map(({ note, cover }) => (
            <a class="article-card reveal" data-note-title={note.data.title} href={`/writing/${getWritingSlug(note.id)}/`}>
              {cover && <img src={cover} alt="" loading="lazy" />}
              <span class="card-label">{note.data.course}</span>
              <h3>{note.data.title}</h3>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('[data-note-search]')!;
  const category = document.querySelector<HTMLSelectElement>('[data-note-category]')!;
  function filter() {
    let total = 0;
    document.querySelectorAll<HTMLElement>('[data-note-group]').forEach(group => {
      let count = 0;
      group.querySelectorAll<HTMLElement>('[data-note-title]').forEach(note => {
        note.hidden = Boolean((category.value && category.value !== group.dataset.noteGroup) || !note.dataset.noteTitle!.toLowerCase().includes(search.value.trim().toLowerCase()));
        if (!note.hidden) count++;
      });
      group.hidden = count === 0; total += count;
    });
    document.querySelector<HTMLElement>('[data-no-results]')!.hidden = total !== 0;
  }
  search.addEventListener('input',filter); category.addEventListener('change',filter);
</script>
