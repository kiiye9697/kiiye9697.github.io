---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../lib/resume";
import { getWritingSlug } from "../../lib/slugs";

export async function getStaticPaths() {
  const notes = await getCollection("writing");
  return notes.map((entry) => ({
    params: { slug: getWritingSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const isRenderFormer = getWritingSlug(entry.id) === '30-renderformer-study';
---

<BaseLayout title={`${entry.data.title} | ${profile.name}`} description={`${entry.data.course} 技术笔记`}>
  <article class:list={["page-shell article-shell", { "renderformer-article": isRenderFormer }]}>
    <header class="article-hero">
      <a class="text-link" href="/writing/">← 返回技术帖</a>
      <span class="card-label">{entry.data.course}</span>
      <h1>{entry.data.title}</h1>
      {entry.data.source && <p>{isRenderFormer ? <a href={entry.data.source}>论文项目主页 ↗</a> : `Source: ${entry.data.source}`}</p>}
    </header>

    <div class="article-body">
      <div class="article-content">
        <Content />
      </div>
      {tocHeadings.length > 0 && (
        <aside class="article-toc">
          <details open>
            <summary>目录</summary>
            <ul>
              {tocHeadings.map((h) => (
                <li class={`toc-depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </details>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .renderformer-article{max-width:1080px}
  .renderformer-article .article-hero{padding-block:56px 32px}
  .renderformer-article .article-hero h1{font-family:'Noto Sans SC Variable',sans-serif;font-weight:650;font-size:clamp(30px,4.2vw,48px);line-height:1.4;letter-spacing:-.035em;max-width:22em}
  .renderformer-article .article-hero>a{display:inline-block;margin-right:20px;font-size:13px}
  .renderformer-article .article-hero p{font-size:13px;margin-top:16px}
  .renderformer-article .article-body{display:block}
  .renderformer-article .article-content{padding:32px 0 0;background:transparent;border:0;border-top:1px solid var(--line);box-shadow:none;border-radius:0}
  .renderformer-article .article-content :global(p){max-width:76ch;line-height:1.95;font-size:16px;margin:0 0 24px}
  .renderformer-article .article-content :global(p:has(img)){max-width:none;margin:32px 0}
  .renderformer-article .article-content :global(img){width:100%;height:auto;max-height:none;box-shadow:none;border:0;border-radius:8px;margin:0;background:#fff}
  .renderformer-article .article-content :global(strong){font-weight:600;color:var(--gold-strong)}
  @media(max-width:640px){.renderformer-article .article-hero{padding-top:32px}.renderformer-article .article-content :global(p){font-size:15px}}
</style>
