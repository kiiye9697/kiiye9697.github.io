---
import BaseLayout from "../layouts/BaseLayout.astro";
import EchoSignal from "../components/EchoSignal.astro";
import GalleryCollection from "../components/GalleryCollection.astro";
import { profile } from "../lib/resume";
---

<BaseLayout
  gallery
  title={`作品集 | ${profile.name}`}
  description="孙浩然的技术美术与渲染作品集"
>
  <div class="gallery-shell">
    <header class="gallery-page-heading gallery-portfolio-heading">
      <span class="gallery-micro">PORTFOLIO / 孙浩然</span>
      <div class="gallery-hero-composition">
        <h1>
          Selected
          <br />
          <i>works.</i>
        </h1>
        <EchoSignal label="WORK / AN OPEN-ENDED PRACTICE" />
      </div>
      <div>
        <p>
          光、空间、系统。
          <br />
          一份持续生长的作品集。
        </p>
        <a
          class="gallery-text-link"
          href={profile.portfolioPdf}
          download="Sun-Haoran-Portfolio.pdf"
        >
          下载作品集 PDF ↗
        </a>
      </div>
    </header>
    <GalleryCollection />
  </div>
</BaseLayout>
