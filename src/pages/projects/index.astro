---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GalleryCollection from "../../components/GalleryCollection.astro";
import { profile } from "../../lib/resume";
---

<BaseLayout
  gallery
  title={`项目 | ${profile.name}`}
  description="渲染作品、研究与交互系统的完整项目目录"
>
  <div class="gallery-shell">
    <header class="gallery-page-heading">
      <span class="gallery-micro">PROJECT INDEX / 项目目录</span>
      <h1>
        Ideas into
        <br />
        <i>existence.</i>
      </h1>
      <div>
        <p>
          从渲染管线到交互系统，
          <br />
          记录想法被实现的过程。
        </p>
        <a class="gallery-text-link" href="#research">
          研究与系统 ↓
        </a>
      </div>
    </header>
    <GalleryCollection />
  </div>
</BaseLayout>
