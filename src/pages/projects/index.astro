---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { activeProjects, profile, projectCategories } from "../../lib/resume";
---

<BaseLayout title={`项目 | ${profile.name}`} description="按开发项目、学校作业课设、AI work 和论文工作分类的项目库">
  <div class="page-shell">
    <SectionHeader
      eyebrow="Projects"
      title="项目"
      description="当前先展示平台项目与论文工作。开发项目、AI work 和更多课程项目会在材料确认后继续补全。"
    />

    <div class="category-grid">
      {projectCategories.map((category) => (
        <a class="category-card reveal" href={`#${category.id}`}>
          <span class="card-label">{category.kicker}</span>
          <h3>{category.label}</h3>
          <p>{category.description}</p>
        </a>
      ))}
    </div>

    {projectCategories.map((category) => {
      const group = activeProjects.filter((project) => project.category === category.id);
      return (
        <section class="page-section project-category-section" id={category.id}>
          <SectionHeader
            eyebrow={category.kicker}
            title={category.label}
            description={category.description}
          />
          <div class="project-grid">
            {group.length > 0 ? (
              group.map((project) => (
                <a class="project-card reveal" href={`/projects/${project.slug}/`}>
                  <img src={project.cover} alt="" loading="lazy" />
                  <div>
                    <span>{project.eyebrow} · {project.status}</span>
                    <h3>{project.title}</h3>
                    <p>{project.summary}</p>
                    <div class="tag-row">
                      {project.tags.map((tag) => <span>{tag}</span>)}
                    </div>
                  </div>
                </a>
              ))
            ) : (
              <article class="project-card scene-set-card reveal">
                <div>
                  <span>{category.kicker}</span>
                  <h3>内容整理中</h3>
                  <p>这一栏先保留结构，等项目材料、截图和说明确认后再放入公开展示。</p>
                </div>
              </article>
            )}
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>
