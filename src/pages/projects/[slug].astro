---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { activeProjects, profile, projectCategories } from "../../lib/resume";

export function getStaticPaths() {
  return activeProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const category = projectCategories.find((item) => item.id === project.category);
---

<BaseLayout title={`${project.title} | ${profile.name}`} description={project.summary}>
  <div class="page-shell narrow">
    <article class="project-detail reveal">
      <img src={project.cover} alt="" loading="eager" />
      <span class="card-label">{category?.label ?? "Project"} · {project.status}</span>
      <h1>{project.title}</h1>
      <p>{project.summary}</p>

      <div class="tag-row">
        {project.tags.map((tag) => <span>{tag}</span>)}
      </div>

      <section>
        <h2>项目要点</h2>
        <ul>
          {project.highlights.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <div class="hero-actions compact">
        {project.links.map((link) => (
          <a class="button" href={link.href} target={link.href.startsWith("http") || link.href.endsWith(".pdf") ? "_blank" : undefined} rel={link.href.startsWith("http") || link.href.endsWith(".pdf") ? "noreferrer" : undefined}>
            {link.label}
          </a>
        ))}
        <a class="button ghost" href={`/projects/#${project.category}`}>返回分类</a>
      </div>
    </article>
  </div>
</BaseLayout>
