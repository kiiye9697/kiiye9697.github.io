---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { activeProjects, profile, projectCategories } from "../../lib/resume";
import { galleryProjects } from "../../lib/gallery";
export function getStaticPaths() {
  return activeProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}
const { project } = Astro.props;
const category = projectCategories.find((item) => item.id === project.category);
const display = galleryProjects.find((item) => item.slug === project.slug);
---

<BaseLayout
  gallery
  title={`${project.title} | ${profile.name}`}
  description={project.summary}
>
  <article class="gallery-shell gallery-detail">
    <a class="gallery-detail-back" href="/projects/">
      ← 项目目录 / PROJECT INDEX
    </a>
    <header class="gallery-detail-header">
      <span class="gallery-micro">
        {category?.label} / {project.status}
      </span>
      <h1>{project.title}</h1>
      <p>{project.summary}</p>
      <div class="gallery-detail-tags">
        {project.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </header>
    {display?.displayMode === "featured" && (
      <figure class="gallery-detail-image">
        <img
          src={project.cover}
          alt={`${project.title} 渲染效果`}
          fetchpriority="high"
        />
        <figcaption>
          {project.title} / {project.tags[0]}
        </figcaption>
      </figure>
    )}
    <section class="gallery-detail-section">
      <h2>01 / 项目要点</h2>
      <ul>
        {project.highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </section>
    {project.techPosts && project.techPosts.length > 0 && (
      <section class="gallery-detail-section">
        <h2>02 / 技术拆解</h2>
        <div class="gallery-detail-posts">
          {project.techPosts.map((post) => (
            <a href={post.href}>
              <span>{post.title}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
    )}
    <div class="gallery-detail-links">
      {project.links
        .filter((link) => !link.label.startsWith("返回"))
        .map((link) => (
          <a
            class="gallery-text-link"
            href={link.href}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
          >
            {link.label} ↗
          </a>
        ))}
      <a class="gallery-text-link" href={`/projects/#${project.category}`}>
        返回目录 ↑
      </a>
    </div>
  </article>
</BaseLayout>
