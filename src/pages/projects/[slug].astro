---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { activeProjects, profile, projectCategories } from "../../lib/resume";

export function getStaticPaths() {
  return activeProjects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const category = projectCategories.find((item) => item.id === project.category);
---

<BaseLayout title={`${project.title} | ${profile.name}`} description={project.summary}>
  <div class="page-shell narrow">
    <article class="project-detail reveal">
      <img src={project.cover} alt="" loading="eager" />
      <span class="card-label">{category?.label ?? "Project"} · {project.status}</span>
      <h1>{project.title}</h1>
      <p>{project.summary}</p>

      <div class="tag-row">
        {project.tags.map((tag) => <span>{tag}</span>)}
      </div>

      <section>
        <h2>项目要点</h2>
        <ul>
          {project.highlights.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section>
        <h2>技术拆解</h2>
        {project.techPosts && project.techPosts.length > 0 ? (
          <div class="tech-post-list">
            {project.techPosts.map((post) => (
              <a class="tech-post-row" href={post.href}>
                <span>{post.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        ) : (
          <p class="muted">算法原理与实现细节整理中。</p>
        )}
      </section>

      <div class="hero-actions compact">
        {project.links.map((link) => (
          <a class="button" href={link.href} target={link.href.startsWith("http") || link.href.endsWith(".pdf") ? "_blank" : undefined} rel={link.href.startsWith("http") || link.href.endsWith(".pdf") ? "noreferrer" : undefined}>
            {link.label}
          </a>
        ))}
        <a class="button ghost" href={`/projects/#${project.category}`}>返回分类</a>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .tech-post-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .tech-post-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    border: 1px solid var(--gray-700, #333);
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--gray-200, #ccc);
    transition: border-color 0.2s, color 0.2s;
  }
  .tech-post-row:hover {
    border-color: var(--gray-500, #666);
    color: var(--gray-0, #fff);
  }
  .tech-post-row span:last-child {
    opacity: 0.5;
  }
</style>
