---
import { ArrowDown } from '@lucide/astro';
import worlds from '../lib/worlds.json';
---
<section class="matchday-hero" aria-label="Kiiye9697">
  <img class="matchday-photo seeded-hero" src={worlds[0].image} alt={worlds[0].alt} width="2912" height="1344" fetchpriority="high" />
  <script define:vars={{ worlds }}>
    (() => {
      const image = document.querySelector('.seeded-hero');
      const scene = worlds[Number(document.documentElement.dataset.worldIndex) || 0];
      image.src = scene.image;
      image.alt = scene.alt;
    })();
  </script>
  <div class="matchday-title">
    <h1>Kiiye9697</h1>
    <div class="matchday-bottom">
      <p>孙浩然<span>技术美术 / 引擎渲染</span></p>
      <a class="hero-link" href="#selected" aria-label="浏览作品"><ArrowDown size={24} /></a>
    </div>
  </div>
</section>
