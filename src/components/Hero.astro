---
import { profile } from "../lib/resume";
---

<section class="wallpaper-hero" aria-label="Kiiye9697 blog wallpaper opening">
  <div class="wallpaper-backdrop" aria-hidden="true"></div>
  <div class="wallpaper-glow" aria-hidden="true"></div>
  <div class="wallpaper-crest-badge reveal" aria-hidden="true">
    <img src="/liverbird-crest.png" alt="" />
  </div>

  <div class="wallpaper-content reveal">
    <p class="wallpaper-kicker">ANFIELD MODE / TECHNICAL ART</p>
    <h1>You'll Never Walk Alone</h1>
    <p class="blog-mark">Kiiye9697's blog</p>
    <p class="wallpaper-subtitle">{profile.title} · PCG / Rendering / AI Work</p>
    <p class="wallpaper-note">
      把作品、技术笔记和项目拆解做成一张长期更新的主场海报。
    </p>
    <div class="hero-actions wallpaper-actions">
      <a class="button gold" href="/portfolio/">作品集</a>
      <a class="button primary" href="/projects/">项目</a>
      <a class="button ghost" href="/writing/">技术帖</a>
    </div>
  </div>

  <div class="wallpaper-footer reveal delay-1">
    <span>{profile.nameReal}</span>
    <span>{profile.email}</span>
    <a href="/resume/">Resume 2028</a>
  </div>
</section>

<div class="signal-strip" aria-hidden="true">
  <span>ANFIELD ENERGY</span>
  <span>UNITY URP</span>
  <span>RENDERFEATURE</span>
  <span>NPR SHADER</span>
  <span>PCG</span>
  <span>AIGC PIPELINE</span>
  <span>RAYTRACING</span>
  <span>LOOKDEV</span>
  <span>PORTFOLIO IN PROGRESS</span>
</div>
