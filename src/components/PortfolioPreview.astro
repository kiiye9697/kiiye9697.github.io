---
import SectionHeader from "./SectionHeader.astro";
import { portfolioHighlights, profile } from "../lib/resume";
---

<section class="page-section">
  <SectionHeader
    eyebrow="Portfolio"
    title="作品集"
    description="作品集 PDF 与项目入口。"
  />

  <div class="portfolio-band reveal">
    <div>
      <span class="card-label">PDF Portfolio</span>
      <h3>PDF 版本作品集</h3>
    </div>
    <a class="button gold" href={profile.portfolioPdf} target="_blank" rel="noreferrer">查看 PDF</a>
  </div>

  <div class="list-stack">
    {portfolioHighlights.map((item) => (
      <a class="list-row reveal" href={item.href}>
        <div>
          <span class="card-label">Portfolio Link</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>
