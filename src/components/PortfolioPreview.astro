---
import SectionHeader from "./SectionHeader.astro";
import { portfolioHighlights, profile } from "../lib/resume";
---

<section class="page-section">
  <SectionHeader
    eyebrow="Portfolio"
    title="作品集"
    description="作品集 PDF 与项目入口。"
  />

  <div class="portfolio-band reveal">
    <div>
      <span class="card-label">PDF Portfolio</span>
      <h3>PDF 版本作品集</h3>
    </div>
    <a class="button gold" href={profile.portfolioPdf} target="_blank" rel="noreferrer">查看 PDF</a>
  </div>

  <a class="portfolio-showcase reveal" href="/projects/classic-sponza-urp/">
    <img src="https://kiiyeblog.oss-cn-beijing.aliyuncs.com/SponzaShowcase.png" alt="Classic Sponza URP" loading="lazy" />
    <div>
      <span class="card-label">Scene Set 01</span>
      <h3>Classic Sponza URP 渲染管线扩展</h3>
      <p>GTAO、SSR、TAA、体积光、Bloom、高度雾 6 个渲染特性。</p>
    </div>
    <span aria-hidden="true">↗</span>
  </a>

  <div class="list-stack">
    {portfolioHighlights.map((item) => (
      <a class="list-row reveal" href={item.href}>
        <div>
          <span class="card-label">Portfolio Link</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</section>
