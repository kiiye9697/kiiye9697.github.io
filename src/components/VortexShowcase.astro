---
import { experiments } from "../lib/experiments";
const first = experiments[0];
---
<figure class="vortex-showcase" data-vortex data-experiments={JSON.stringify(experiments)} data-experiment={first.id}>
  <div class="vortex-stage">
    {[0, 1].map((slot) => (
      <div class:list={["vortex-slot", { "is-active": slot === 0 }]} data-slot data-treatment={first.treatment} style={`--experiment-scale:${first.scale}`} aria-hidden={slot === 1 ? "true" : undefined}>
        <img class="vortex-poster" data-poster src={slot === 0 ? first.poster : undefined} alt="" width="720" height="720" decoding="async" />
        <video class="vortex-video" muted loop playsinline preload="none" aria-label={`${first.title}，预渲染流体实验影像`} tabindex="-1"></video>
      </div>
    ))}
  </div>
  <figcaption class="vortex-caption">
    <span class="vortex-title" data-experiment-title aria-live="polite" aria-atomic="true">{first.title}</span>
    <span class="vortex-counter" data-experiment-counter>01 / 03</span>
    <div class="vortex-controls" data-experiment-controls hidden>
      <button class="vortex-roll" type="button" data-experiment-roll aria-label="随机切换另一个实验">Roll <span aria-hidden="true">↻</span></button>
      <button class="vortex-toggle" type="button" data-experiment-toggle aria-label="播放实验影像"><span aria-hidden="true">▷</span></button>
    </div>
  </figcaption>
  <span class="vortex-status" data-experiment-status role="status"></span>
</figure>
<style>
  .vortex-showcase { margin: 0; width: 100%; max-width: 570px; color: #e4e8dd; }
  .vortex-stage { position: relative; width: 100%; aspect-ratio: 1; background: #0b100d; isolation: isolate; }
  .vortex-slot { position: absolute; inset: 0; opacity: 0; pointer-events: none; mix-blend-mode: screen; transition: opacity 400ms ease, filter 400ms ease; filter: blur(5px); mask-image: radial-gradient(ellipse 71% 72% at 50% 50%, #000 61%, transparent 74%); }
  .vortex-slot.is-active { opacity: 1; filter: blur(0); }
  .vortex-poster, .vortex-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transform: scale(var(--experiment-scale, 1)); }
  .vortex-slot[data-treatment="charcoal"] :is(img, video) { filter: brightness(.8) contrast(2.4) saturate(1.1); }
  .vortex-slot[data-treatment="white"] :is(img, video) { filter: invert(1) contrast(1.22) brightness(1.35); }
  .vortex-slot[data-treatment="white-color"] :is(img, video) { filter: invert(1) contrast(1.18) brightness(1.3) saturate(1.15); }
  .vortex-video { opacity: 0; transition: opacity 180ms ease; }
  .vortex-slot.has-frame .vortex-video { opacity: 1; }
  .vortex-caption { display: flex; align-items: center; gap: 15px; min-height: 44px; margin-top: 9px; }
  .vortex-title { font: 12px/1.6 "IBM Plex Mono", monospace; letter-spacing: .1em; }
  .vortex-counter { margin-left: auto; color: #8e9b88; font: 9px/1.5 "IBM Plex Mono", monospace; white-space: nowrap; }
  .vortex-controls { display: flex; align-items: center; gap: 7px; }
  .vortex-controls button { appearance: none; border: 0; background: transparent; color: #a9b3a1; padding: 9px 5px; font: 11px/1 "IBM Plex Mono", monospace; cursor: pointer; }
  .vortex-roll span { margin-left: 5px; font-size: 16px; vertical-align: middle; color: #b5f36a; }
  .vortex-toggle { min-width: 40px; min-height: 40px; font-size: 15px !important; }
  .vortex-controls button:hover { color: #b5f36a; }
  .vortex-controls button:disabled { opacity: .4; cursor: wait; }
  .vortex-controls button:focus-visible { outline: 2px solid #b5f36a; outline-offset: 3px; }
  .vortex-status { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media(max-width: 420px) { .vortex-caption { gap: 8px; } .vortex-title { font-size: 10px; letter-spacing: .045em; } .vortex-counter { font-size: 8px; } .vortex-controls { gap: 1px; } .vortex-controls button { font-size: 11px; } }
  @media(prefers-reduced-motion: reduce) { .vortex-slot, .vortex-video { transition: none; } }
</style>
<script>
  import "../scripts/vortex-showcase";
</script>
