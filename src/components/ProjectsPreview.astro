---
import SectionHeader from "./SectionHeader.astro";
import { activeProjects, projectCategories } from "../lib/resume";
---

<section class="page-section">
  <SectionHeader
    eyebrow="Projects"
    title="项目索引"
    description="先保留平台项目与论文工作两条线，其他内容等材料成熟后再放进来。"
  />

  <div class="category-grid">
    {projectCategories.map((category) => {
      const count = activeProjects.filter((project) => project.category === category.id).length;
      return (
        <a class="category-card reveal" href={`/projects/#${category.id}`}>
          <span class="card-label">{category.kicker}</span>
          <h3>{category.label}</h3>
          <p>{category.description}</p>
          <strong>{count > 0 ? `${count} items` : "整理中"}</strong>
        </a>
      );
    })}
  </div>

  <div class="panel reveal project-callout">
    <span class="card-label">Material Checklist</span>
    <h3>项目卡片后续最值得补什么</h3>
    <p>优先顺序建议是封面图、项目一句话定位、3 条技术亮点、仓库或视频链接。</p>
  </div>
</section>
