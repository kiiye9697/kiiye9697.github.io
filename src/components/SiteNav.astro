---
import { navSections, profile } from "../lib/resume";

const pathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const isActive = (href: string) => {
  const normalized = href.endsWith("/") ? href : `${href}/`;
  if (normalized === "/portfolio/" && pathname.startsWith("/projects/")) return true;
  return normalized === "/" ? pathname === "/" : pathname.startsWith(normalized);
};
---

<nav class="site-nav">
  <a class="brand" href="/" aria-label="回到个人主页">
    <span><strong>ECHO<span class="echo-brand-dot">°</span></strong><small>{profile.name}</small></span>
  </a>

  <div class="nav-links" aria-label="主导航">
    {navSections.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
        {item.label}
      </a>
    ))}
  </div>

  <div class="nav-actions">
    <a href="/resume/">关于</a>
    <a class="nav-cta" href={profile.resumePdf} download="Sun-Haoran-Resume.pdf">下载简历</a>
  </div>
</nav>
