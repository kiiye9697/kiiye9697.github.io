---
import worlds from '../lib/worlds.json';
---
<script define:vars={{ worlds }}>
  (() => {
    const root = document.documentElement;
    const requested = new URLSearchParams(location.search).get('seed');
    const explicit = requested !== null && /^\d{1,10}$/.test(requested) && Number(requested) <= 4294967295;
    const navigation = performance.getEntriesByType('navigation')[0];
    let saved;
    try { saved = sessionStorage.getItem('orbital-seed'); } catch {}
    let seed = explicit ? Number(requested) : navigation?.type !== 'reload' && saved !== null && saved !== undefined && /^\d+$/.test(saved) ? Number(saved) >>> 0 : crypto.getRandomValues(new Uint32Array(1))[0];
    try { sessionStorage.setItem('orbital-seed', String(seed)); } catch {}
    // A fixed seed reproduces the scene and dissolve; local time only affects glass.
    let state = seed >>> 0;
    const random = () => {
      state += 0x6D2B79F5;
      let value = Math.imul(state ^ state >>> 15, state | 1);
      value ^= value + Math.imul(value ^ value >>> 7, value | 61);
      return ((value ^ value >>> 14) >>> 0) / 4294967296;
    };
    const index = Math.floor(random() * worlds.length);
    root.dataset.worldSeed = String(seed);
    root.dataset.worldIndex = String(index);
    root.style.setProperty('--scene-position', `${(60 + random() * 10).toFixed(2)}%`);
    root.style.setProperty('--scene-saturation', (0.9 + random() * .16).toFixed(3));
    const visitedAt = new Date();
    const hour = visitedAt.getHours() + visitedAt.getMinutes() / 60;
    const daylight = (1 + Math.cos((hour - 13) * Math.PI / 12)) / 2;
    const twilight = Math.exp(-Math.pow((hour - 18) / 2, 2));
    // Freeze the material at page entry; no timer or location request.
    root.style.setProperty('--glass-blur', `${(20 - daylight * 10).toFixed(2)}px`);
    root.style.setProperty('--glass-alpha', (0.86 - daylight * 0.28).toFixed(3));
    const tint = worlds[index].tint;
    root.style.setProperty('--glass-rgb', `${Math.round(tint[0] + twilight * 12)} ${Math.round(tint[1] + daylight * 4)} ${Math.round(tint[2] + daylight * 4)}`);
    root.style.setProperty('--glass-edge', (0.14 + daylight * 0.14).toFixed(3));
    root.style.setProperty('--scene-light', (0.76 + daylight * 0.24).toFixed(3));
    root.dataset.atmosphere = hour < 6 || hour >= 21 ? 'night' : hour < 10 ? 'morning' : hour < 17 ? 'day' : 'evening';
  })();
</script>
