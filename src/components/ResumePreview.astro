---
import SectionHeader from "./SectionHeader.astro";
import { education, profile, resumeSkills } from "../lib/resume";
---

<section class="page-section">
  <SectionHeader
    eyebrow="Resume"
    title="简历"
    description="教育经历、技能方向与联系方式独立成页，PDF 简历保留完整版本入口。"
  />

  <div class="resume-grid">
    <article class="panel resume-card reveal">
      <span class="card-label">Target</span>
      <h3>{profile.title}</h3>
      <p>{profile.location} · {profile.phone}</p>
      <a class="text-link" href="/resume/">进入简历页 →</a>
    </article>

    <article class="panel resume-card reveal delay-1">
      <span class="card-label">Education</span>
      <h3>{education[0].school}</h3>
      <p>{education[0].degree}</p>
      <p class="muted">{education[0].period}</p>
    </article>
  </div>

  <div class="skill-strip">
    {resumeSkills.slice(0, 3).map((group) => (
      <article class="reveal">
        <h3>{group.category}</h3>
        <div class="tag-row">
          {group.items.slice(0, 3).map((item) => <span>{item}</span>)}
        </div>
      </article>
    ))}
  </div>
</section>
